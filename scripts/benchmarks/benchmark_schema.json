{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["metadata", "capabilities", "queries"],
  "properties": {
    "metadata": {"type":"object","required":["seed","verification","runs","warmups","timing","percentiles","cache_policy","counter_policy"]},
    "capabilities": {"type":"object","required":["indexed","baseline"]},
    "queries": {"type":"object","minProperties":1,"maxProperties":20,"additionalProperties":{"type":"object","required":["definition","execution_order","indexed","baseline"],"properties":{"indexed":{"$ref":"#/$defs/measurement"},"baseline":{"$ref":"#/$defs/measurement"}}}}
  },
  "$defs": {
    "measurement": {
      "type":"object",
      "required":["query_id","variant","plan","params","warmups","runs","samples_ms","p50_ms","p95_ms","p99_ms","session_counter_mean_per_run","result_count","result_sha256","inconclusive_reasons"],
      "properties":{
        "samples_ms":{"type":"array","minItems":1,"items":{"type":"number","minimum":0}},
        "p50_ms":{"type":"number","minimum":0},"p95_ms":{"type":"number","minimum":0},"p99_ms":{"type":"number","minimum":0},
        "plan":{"type":"object","required":["raw","tables","temporary","filesort"]},
        "session_counter_mean_per_run":{"type":"object","additionalProperties":{"type":["number","null"]}},
        "result_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    }
  }
}
